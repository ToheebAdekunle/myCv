{
  "name": "ftx-documentary-video",
  "private": true,
  "version": "0.1.0",
  "description": "Remotion projects: FTX documentary title card and survival Shorts",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts TitleCard out/title-card.mp4",
    "still": "remotion still src/index.ts TitleCard out/title-card.png --frame=60",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "render:sinking": "remotion render src/index.ts SinkingCar out/sinking-car.mp4",
    "render:shadow": "remotion render src/index.ts ShadowLazy out/shadow-lazy.mp4",
    "render:shadow-me": "remotion render src/index.ts ShadowMe out/shadow-me.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.543",
    "@remotion/three": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
